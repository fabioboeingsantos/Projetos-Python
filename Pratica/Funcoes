1. Calcular desconto de um produto

def calcular_desconto(preco, porcentagem):
    desconto = preco * (porcentagem / 100)
    return preco - desconto

print(calcular_desconto(100, 10))  # 90

2. Converter minutos em horas e minutos

def converter_tempo(minutos):
    horas = minutos // 60
    resto = minutos % 60
    return horas, resto

h, m = converter_tempo(130)
print(f"{h}h {m}min")  # 2h 10min

3. Calcular média de notas
def calcular_media(notas):

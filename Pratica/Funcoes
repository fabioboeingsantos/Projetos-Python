10. Verificar se um número é par ou ímpar
def par_ou_impar(numero):
    if numero % 2 == 0:
        return "Par"
    else:
        return "Ímpar"
    
print(par_ou_impar(10))  # Par
print(par_ou_impar(7))   # Ímpar

11. Calcular o fatorial de um número
def fatorial(n):
    if n == 0 or n == 1:
        return 1
    else:
        return n * fatorial(n - 1)
print(fatorial(5))  # 120

